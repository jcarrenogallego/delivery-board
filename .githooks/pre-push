#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$repo_root/scripts/validate-staged.ps1" -AllowEmptyStagedDiff
fi

exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/validate-staged.ps1" -AllowEmptyStagedDiff
