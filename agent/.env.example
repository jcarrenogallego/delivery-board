# No pegues claves en código, documentación o consola compartida.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternativa local: cambia MODEL_PROVIDER a ollama.
# qwen3:4b es el de la guía de sesión14. Puedes probar el antiguo
# qwen2.5-coder:1.5b, pero debe superar primero prueba:tools.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Puertos del laboratorio anterior. Ajusta si Aspire asigna otros.
DELIVERY_API_URL=http://localhost:5202
MCP_URL=http://127.0.0.1:5091/mcp

# inline = contenido completo al iniciar; progressive = catálogo + cargar_skill.
SKILLS_MODE=inline
MAX_SQL_ATTEMPTS=2
MAX_MODEL_CALLS=12
RECURSION_LIMIT=40
REQUEST_TIMEOUT_MS=120000

# Punto de partida: no enviar trazas hasta preparar sesión15.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=delivery-board-agent-sesion15
