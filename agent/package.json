{
  "name": "delivery-board-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "preguntar": "node --env-file-if-exists=.env scripts/preguntar.ts",
    "prueba:config": "node --env-file-if-exists=.env scripts/prueba-config.ts",
    "prueba:skills": "node --env-file-if-exists=.env scripts/prueba-skills.ts",
    "prueba:conexion": "node --env-file-if-exists=.env scripts/prueba-conexion.ts",
    "prueba:mcp": "node --env-file-if-exists=.env scripts/prueba-mcp.ts",
    "prueba:modelo": "node --env-file-if-exists=.env scripts/prueba-modelo.ts",
    "prueba:tools": "node --env-file-if-exists=.env scripts/prueba-tools.ts",
    "prueba:stream": "node --env-file-if-exists=.env scripts/prueba-stream.ts",
    "prueba:offline": "node scripts/prueba-offline.ts",
    "grafo": "node scripts/dibujar.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.5.2",
    "@langchain/mcp-adapters": "2.0.1",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.8.0",
    "langchain": "1.6.0",
    "langsmith": "0.11.8",
    "yaml": "^2.8.0",
    "zod": "4.6.7"
